# Copy to .env and fill in. .env is gitignored.

# --- WhatsApp (Meta Cloud API) ---
VERIFY_TOKEN=
ACCESS_TOKEN=
PHONE_NUMBER_ID=
GRAPH_API_VERSION=v21.0

# --- LLM (Gemini via Google AI Studio key — no GCP project needed) ---
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
MODEL=gemini-2.5-flash

# --- Storage (MongoDB) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=clinic-ai-agent
# Stamped on every conversations doc (console data contract). Change per clinic.
CLINIC_ID=main-clinic

# --- Conversation finalize + analytics (idle sweeper) ---
# All optional; shown with their defaults.
ANALYTICS_ENABLED=true
IDLE_TIMEOUT_MINUTES=30       # silence after which a conversation is closed
SWEEP_SECONDS=60             # how often the background sweeper runs
ANALYTICS_STUCK_MINUTES=10    # reclaim analytics stuck in "processing"

# --- Inbound debounce (coalesce rapid WhatsApp bubbles) ---
# All optional; shown with their defaults.
DEBOUNCE_ENABLED=true
DEBOUNCE_WINDOW_SECONDS=5.0   # quiet gap before flushing a batch
DEBOUNCE_MAX_WAIT_SECONDS=30.0  # hard cap even if still typing
DEBOUNCE_TICK_SECONDS=1.0     # how often the flusher polls

# --- App ---
LOG_LEVEL=INFO
PORT=3000
