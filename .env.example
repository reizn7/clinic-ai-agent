# Copy to .env and fill in. .env is gitignored.

# --- WhatsApp (Meta Cloud API) ---
VERIFY_TOKEN=
ACCESS_TOKEN=
PHONE_NUMBER_ID=
GRAPH_API_VERSION=v21.0

# --- LLM (Gemini via Google AI Studio key — no GCP project needed) ---
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
MODEL=gemini-3.5-flash-lite
MODEL_FALLBACKS=gemini-3.5-flash,groq:openai/gpt-oss-20b   # tried in order if MODEL is overloaded (429/5xx); groq:* needs GROQ_API_KEY
MODEL_RETRY_ATTEMPTS=3

# --- Storage (MongoDB) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=clinic-ai-agent
# Stamped on every conversations doc (console data contract). Change per clinic.
CLINIC_ID=main-clinic

# --- Conversation finalize + analytics (idle sweeper) ---
# All optional; shown with their defaults.
ANALYTICS_ENABLED=true
IDLE_TIMEOUT_MINUTES=30       # silence after which a conversation is closed
SWEEP_SECONDS=60             # how often the background sweeper runs
ANALYTICS_STUCK_MINUTES=10    # reclaim analytics stuck in "processing"

# --- Inbound debounce (coalesce rapid WhatsApp bubbles) ---
# All optional; shown with their defaults.
DEBOUNCE_ENABLED=true
DEBOUNCE_WINDOW_SECONDS=5.0   # quiet gap before flushing a batch
DEBOUNCE_MAX_WAIT_SECONDS=30.0  # hard cap even if still typing
DEBOUNCE_TICK_SECONDS=1.0     # how often the flusher polls

# --- Voice channel (browser call page -> Gemini Live) ---
# All optional; shown with their defaults.
VOICE_ENABLED=true            # serve the call page (/voice/call) and its WebSocket (/voice/ws)
VOICE_MODEL=gemini-3.8-live   # Gemini Live native-audio model (supports function calling)
VOICE_NAME=                   # optional prebuilt voice (e.g. Kore, Puck); empty = model default
VOICE_WS_TOKEN=               # optional shared secret; if set, open /voice/call?token=<value>

# --- Appointment follow-ups (doctor calendar + WhatsApp confirmations) ---
CLINIC_TIMEZONE=Asia/Kolkata          # appointment date+slot are local to this zone
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_FILE=          # path to the service account JSON key, or…
GOOGLE_SERVICE_ACCOUNT_JSON=          # …the key JSON itself (one line)
WHATSAPP_CONFIRMATIONS_ENABLED=true
# Approved Meta template names (needed to reach voice callers outside the 24h
# window). Empty = plain text, which only works inside the window.
WHATSAPP_TEMPLATE_BOOKED=
WHATSAPP_TEMPLATE_RESCHEDULED=
WHATSAPP_TEMPLATE_CANCELLED=
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Tracing (Langfuse) ---
# Off by default. Create a project at https://cloud.langfuse.com (or self-host),
# then Project Settings -> API Keys. EU cloud: https://cloud.langfuse.com,
# US cloud: https://us.cloud.langfuse.com, self-hosted: your own URL.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development   # shows as a filter in Langfuse (development/production)
LANGFUSE_MASK_PHONES=true          # redact phone numbers + hash patient ids in traces
# LANGFUSE_RELEASE=                # optional: deploy id (e.g. git sha); defaults to the package version

# --- App ---
LOG_LEVEL=INFO
PORT=3000
